{
  "name": "antresehat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "typecheck": "tsc --noEmit",
